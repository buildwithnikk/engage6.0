# Gemini — free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq fallback for when Gemini returns 429: https://console.groq.com
GROQ_API_KEY=

# Supabase free project: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ed25519 keypair for signed QR passes. Generate with: npm run keygen
PASS_PRIVATE_KEY=
NEXT_PUBLIC_PASS_PUBLIC_KEY=
