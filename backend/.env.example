# ---------------------------------------------------------------------------
# Sahayak backend configuration.
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---------------------------------------------------------------------------

APP_VERSION=0.1.0
ENVIRONMENT=development

# Origins allowed to call this API, comma-separated, no trailing slash.
# Add your deployed frontend origin when you deploy. Do not use "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only enable with explicit origins above; a wildcard origin forces this off.
# Set to true for cookie-backed administrative sessions across origins.
CORS_ALLOW_CREDENTIALS=true

# Cookie settings for admin sessions (Secure=false in local dev, true in production)
ADMIN_SESSION_COOKIE_NAME=sahayak_admin_session
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Database — SECRET.
#
# DEVELOPMENT uses LOCAL PostgreSQL. Do not point development at the cloud.
# The easiest path is the repo script, which creates the role and database and
# writes DATABASE_URL here for you (it never prints the password):
#
#     ./scripts/setup-local-db.sh
#
# That produces a line of this form:
#     postgresql+psycopg://sahayak_app:[PASSWORD]@127.0.0.1:5432/sahayak_dev
#
# DEPLOYMENT uses Supabase. Get the exact string from Dashboard -> Connect and
# set it in the deployment environment only (never in this file):
#     postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
#
# Use the SESSION POOLER (port 5432) rather than the direct connection unless the
# host has IPv6 — on Free tier the direct connection is IPv6-only.
# Percent-encode & # ? and spaces in the password. See docs/database-schema.md.
#
# Leaving this blank is valid: the app starts and health reports "unconfigured".
# ---------------------------------------------------------------------------
DATABASE_URL=

# Seconds before the health check gives up on the database.
DB_CONNECT_TIMEOUT=3
