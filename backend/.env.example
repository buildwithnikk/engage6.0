# ---------------------------------------------------------------------------
# Sahayak backend configuration.
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---------------------------------------------------------------------------

APP_VERSION=0.1.0
ENVIRONMENT=development

# Origins allowed to call this API, comma-separated, no trailing slash.
# Add your deployed frontend origin when you deploy. Do not use "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only enable with explicit origins above; a wildcard origin forces this off.
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Database — SECRET. Leave blank in Phase 0: the app runs fine without it and
# /api/v1/health will report database "unconfigured", which is correct.
#
# Get the exact string from the Supabase Dashboard -> Connect. Use the DIRECT
# connection (port 5432) on an IPv6-capable network; on an IPv4-only network use
# the SESSION POOLER (also 5432, host differs, user is postgres.[PROJECT-REF]).
# Add the +psycopg driver prefix, and percent-encode & # ? and spaces in the password.
#
#   postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
#
# See docs/database-schema.md section 7.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Seconds before the health check gives up on the database.
DB_CONNECT_TIMEOUT=3
